{
  "agent": "implementer",
  "tier": "T1",
  "_comment": "Pre-yield git evidence is the local final head_sha; host branch capture follows a successful child result. All completion modes require REPORTED, reviewer handoff, and release. An open linked escalation pauses completion without changing ownership; the architect reconciles durable work after the escalation closes. Routing is enforced at the write seam, while handoff uses the agent:reviewer label.",
  "completion": [
    {
      "check": "delivery",
      "require": "metadata.head_sha",
      "when": "git"
    },
    {
      "check": "output_ref",
      "require": "metadata.output_ref",
      "when": [
        "artifact",
        "comment",
        "external"
      ]
    },
    {
      "check": "artifact_path",
      "require": "artifact.output_ref contained",
      "when": "artifact"
    },
    {
      "check": "handoff",
      "require": "label ~ ^agent:reviewer$"
    },
    {
      "check": "unclaimed",
      "require": "assignee cleared"
    },
    {
      "check": "reported",
      "require": "comment.verb in [REPORTED]"
    }
  ],
  "authority": {
    "deny_states": [
      "closed"
    ],
    "deny_metadata": [
      "merge_sha",
      "pr"
    ]
  },
  "escape": {
    "state": "blocked",
    "require": "comment.verb in [FAILED, BLOCKED, ASK]"
  },
  "pause": [
    "open-escalation-wisp-linked-to-node"
  ],
  "bounce": {
    "max_attempts": 3
  }
}
