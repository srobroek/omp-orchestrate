#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

same_hook() {
	local candidate="$1"
	local current="$repo_root/.githooks/pre-commit"
	[[ "$candidate" == "$current" ]] && return 0
	[[ -f "$candidate" && -f "$current" ]] || return 1
	# A linked worktree may retain a symlink in the common hooks directory.
	# Comparing content avoids recursing through that symlink without requiring
	# platform-specific realpath flags.
	cmp -s -- "$candidate" "$current"
}

# Activation records the previous hook path in local Git config. If no path was
# configured, preserve the conventional common .git/hooks/pre-commit, including
# linked worktrees whose per-worktree git dir has no hooks directory.
previous_hooks="$(git config --get agnix.previousHooksPath || true)"
if [[ -z "$previous_hooks" ]]; then
	common_hooks="$(git rev-parse --git-common-dir)/hooks"
	if [[ -x "$common_hooks/pre-commit" ]]; then
		previous_hooks="$common_hooks"
	fi
fi

if [[ -n "$previous_hooks" ]]; then
	case "$previous_hooks" in
		/*) ;;
		*) previous_hooks="$repo_root/$previous_hooks" ;;
	esac
	if [[ -x "$previous_hooks/pre-commit" ]] && ! same_hook "$previous_hooks/pre-commit"; then
		"$previous_hooks/pre-commit" "$@"
	fi
fi

exec "$repo_root/scripts/check-agnix-staged.sh" "$@"
